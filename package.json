{
  "name": "ds-marketing-web",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Genieology/ds-marketing-web.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "dev": "next dev",
    "dev:export-serve": "http-server out -p 8080",
    "build": "next build --debug",
    "export": "yarn build && next export",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "yarn lint --fix",
    "lint:error-only": "yarn lint --quiet",
    "lint:CI": "yarn lint -f json -o reports/eslint-report.json",
    "typecheck": "tsc --noEmit",
    "prepare": "is-ci || (husky install | chmod u+x .husky/*)",
    "commit": "cz",
    "test": "jest",
    "test:CI": "jest --ci --testLocationInResults --reporters=@casualbot/jest-sonar-reporter --reporters=jest-junit",
    "test:debug": "jest -o --watch --coverage=false",
    "test:updateSnapshots": "jest -u --coverage=false",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run",
    "semantic-release": "semantic-release",
    "deploy": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "sync:master": "git push azure-repo HEAD:master --force",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\""
  },
  "@casualbot/jest-sonar-reporter": {
    "suiteName": "jest tests",
    "outputDirectory": "reports",
    "outputName": "test-report.xml",
    "uniqueOutputName": "false",
    "classNameTemplate": "{classname}-{title}",
    "titleTemplate": "{classname}-{title}",
    "ancestorSeparator": " › ",
    "usePathForSuiteName": "true",
    "relativePaths": "true"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml",
    "ancestorSeparator": " › ",
    "uniqueOutputName": "false",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  },
  "dependencies": {
    "@apollo/client": "^3.8.10",
    "@chakra-ui/icons": "2.1.1",
    "@chakra-ui/next-js": "2.2.0",
    "@chakra-ui/react": "2.8.1",
    "@contentful/rich-text-react-renderer": "^15.19.0",
    "@contentful/rich-text-types": "^16.3.0",
    "@emotion/react": "11.11.3",
    "@emotion/styled": "11.11.0",
    "@googlemaps/js-api-loader": "^1.16.2",
    "@tanstack/react-query": "5.4.3",
    "@types/node": "20.11.0",
    "@types/react-google-recaptcha": "^2.1.8",
    "@types/react-slick": "^0.23.13",
    "accept-language": "3.0.18",
    "algoliasearch": "^4.22.1",
    "axios": "^1.6.1",
    "bootstrap": "^5.3.2",
    "classnames": "^2.3.2",
    "contentful-management": "^11.12.0",
    "date-fns": "^4.1.0",
    "dayjs": "1.11.10",
    "encoding": "0.1.13",
    "framer-motion": "10.16.12",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "i18next": "23.6.0",
    "i18next-browser-languagedetector": "7.2.0",
    "i18next-resources-to-backend": "^1.1.4",
    "lightgallery": "^2.7.2",
    "markdown-to-jsx": "^7.4.0",
    "next": "14.2.35",
    "next-client-cookies": "^1.1.0",
    "react": "18.2.0",
    "react-bootstrap": "^2.9.0",
    "react-cookie": "7.0.1",
    "react-datepicker": "^8.3.0",
    "react-dom": "18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-i18next": "13.5.0",
    "react-icons": "^4.11.0",
    "react-phone-input-2": "^2.15.1",
    "react-slick": "^0.29.0",
    "remixicon": "^3.5.0",
    "sharp": "^0.33.1",
    "slick-carousel": "^1.8.1",
    "typescript": "5.2.2"
  },
  "devDependencies": {
    "@casualbot/jest-sonar-reporter": "2.3.1",
    "@commitlint/cli": "18.4.3",
    "@commitlint/config-conventional": "18.4.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tanstack/eslint-plugin-query": "5.17.20",
    "@testing-library/cypress": "10.0.1",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.1.2",
    "@types/google.maps": "^3.54.5",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.16",
    "@typescript-eslint/eslint-plugin": "6.18.1",
    "@typescript-eslint/parser": "6.12.0",
    "commitizen": "4.3.0",
    "cypress": "13.2.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.53.0",
    "eslint-config-next": "13.5.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "2.15.1",
    "eslint-plugin-i18next": "6.0.3",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "27.4.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-unicorn": "49.0.0",
    "http-server": "14.1.1",
    "husky": "^8.0.3",
    "imagemin-lint-staged": "0.5.1",
    "is-ci": "3.0.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "lint-staged": "14.0.1",
    "prettier": "^3.2.2",
    "react-docgen-typescript": "2.2.2",
    "semantic-release": "22.0.12"
  }
}
