{
  "plugins": [
    {
      "name": "general",
      "options": {
        "srcFolderLocation": "./src/components"
      }
    },
    {
      "name": "css",
      "options": {
        "cssModuleSupport": true,
        "sassSupport": false
      }
    },
    {
      "name": "reactJS",
      "options": {
        "createInterface": true,
        "styleLibrary": "chakraUI",
        "createProps": true,
        "propList": ["testProp", "testProp2"]
      }
    },
    "chakraUI",
    {
      "name": "builderIO",
      "options": {
        "override": true,
        "addChildren": true,
        "name": "__DEFAULT__",
        "builderRegistryPath": "./src/features/builderIo/helpers/builderRegistry.ts",
        "builderRegistryComponentsPath": "@/components"
      }
    }
  ]
}
